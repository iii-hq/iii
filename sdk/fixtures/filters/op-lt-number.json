{
  "description": "$lt with a number",
  "filters": {"input.n": {"$lt": 0}},
  "cases": [
    { "doc": {"input": {"n": -1}}, "expect": true },
    { "doc": {"input": {"n": -0.5}}, "expect": true },
    { "doc": {"input": {"n": 0}}, "expect": false },
    { "doc": {"input": {"n": -0.0}}, "expect": false, "note": "-0 equals 0" },
    { "doc": {"input": {"n": "-1"}}, "expect": false },
    { "doc": {"input": {}}, "expect": false }
  ]
}
