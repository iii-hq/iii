{
  "type": "registerfunction",
  "id": "cron::on-tick",
  "description": "Fires on a cron schedule. Observe it with args { expression }.",
  "request_format": {
    "type": "object",
    "required": [
      "expression",
      "scheduled_time"
    ],
    "properties": {
      "expression": {
        "type": "string"
      },
      "scheduled_time": {
        "type": "string",
        "format": "date-time"
      },
      "actual_time": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "observe": {
    "delivery": "owner",
    "args_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string"
        }
      }
    }
  }
}
