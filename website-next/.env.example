# Copy to .env.local for local work, or set these in Vercel → Project → Environment Variables.
# Both are optional. Leave them unset on preview/demo deployments so nothing reaches production data.

# Loads GTM (GTM-N8DCTFB8), PostHog (us.i.posthog.com) and Common Room signals.
# All three stay behind the cookie banner: nothing loads until a visitor accepts.
# Production: true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Mailmodo endpoint for the "Follow development" email form.
# Unset: the form shows its thank-you but sends nothing.
# Production: https://api.mailmodo.com/api/v1/at/f/b7XMGvRS9B/cdb51f52-a91e-520c-888d-03470a9c8faa
NEXT_PUBLIC_MAILMODO_FORM_URL=
