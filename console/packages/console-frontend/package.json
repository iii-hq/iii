    "@tanstack/router-plugin": "1.168.38",
    "@types/dagre": "^0.7.53",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vitest": "^2.1.9"
  }
