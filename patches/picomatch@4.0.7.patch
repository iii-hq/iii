+// GHSA-fc5q-39xc-vjpf: repeating a branch that already contains an
+// unbounded quantifier can backtrack exponentially, even without alternation.
+const hasUnboundedQuantifier = branch => {
+  let escaped = false;
+  let quoted = false;
+  let bracket = false;
+
+  for (const ch of branch) {
+    if (escaped) {
+      escaped = false;
+      continue;
+    }
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+    if (ch === '"') {
+      quoted = !quoted;
+      continue;
+    }
+    if (quoted) continue;
+    if (ch === '[') bracket = true;
+    if (ch === ']') bracket = false;
+    if (!bracket && (ch === '*' || ch === '+')) return true;
+  }
+
+  return false;
+};
