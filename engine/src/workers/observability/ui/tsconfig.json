{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../../../../console/packages/console-frontend/node_modules/@types/react"],
      "react/*": ["../../../../../console/packages/console-frontend/node_modules/@types/react/*"]
    },
    "typeRoots": [
      "../../../../../console/packages/console-frontend/node_modules/@types",
      "../../../../../node_modules/@types"
    ],
    "types": ["react"]
  },
  "include": ["./page.tsx", "./types.ts", "./styles.d.ts"]
}
