{
  "name": "iii-website",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "iii.dev \u2014 one Next.js static export: landing, manifesto, privacy, /blog, /roadmap (tech specs + decks)",
  "scripts": {
    "dev": "tsx scripts/generate-roadmap-manifest.ts && next dev --port 3100",
    "build": "tsx scripts/validate-roadmap.ts && tsx scripts/generate-roadmap-manifest.ts && next build && tsx scripts/finalize-dist.ts && tsx scripts/generate-blog-md.ts && tsx scripts/generate-llms-agents.ts && tsx scripts/generate-sitemap.ts",
    "preview": "pnpm dlx serve dist -l 4321",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "test": "tsx --test scripts/*.test.ts ../infra/terraform/website/cloudfront_functions/*.test.js",
    "test:dist": "tsx --test tests/dist.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shikijs/rehype": "^4.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.563.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "motion": "^13.4.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "node-html-parser": "^7.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
