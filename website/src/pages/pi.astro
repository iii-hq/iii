---
// iii.dev/pi — "iii vs Pi" landing page. Same construction as the homepage
// (src/pages/index.astro): byte-faithful raw HTML fragments assembled with
// set:html. New sections live in components/landing/sections/pi/; wherever a
// homepage section already makes the same point (the harness-collapse
// diagram, the cross-language demo, the worker registry ticker, the roadmap
// list, the footer) this page imports that exact file unmodified instead of
// re-authoring it. See .claude/SKILL.md for the house style this follows.
import SiteNav from '../components/SiteNav.astro'
import ScrollNav from '../components/ScrollNav.astro'
import HtmlShell from '../layouts/HtmlShell.astro'
import '../styles/landing.css'
import '../styles/pi.css'

import piHeadExtras from '../components/landing/pi-head-extras.html?raw'
import sheetOpen from '../components/landing/sections/01-sheet-open.html?raw'

// New, page-specific sections.
import piHero from '../components/landing/sections/pi/01-hero.html?raw'
import piProblem from '../components/landing/sections/pi/02-problem.html?raw'
import piReframe from '../components/landing/sections/pi/03-reframe.html?raw'
import piCompare from '../components/landing/sections/pi/04-compare.html?raw'
import piDiffLead from '../components/landing/sections/pi/05a-diff-lead.html?raw'
import piDiffPayoff from '../components/landing/sections/pi/05b-diff-payoff.html?raw'
import piDiffGridA from '../components/landing/sections/pi/05c-diff-grid-a.html?raw'
import piDiffWorkerLead from '../components/landing/sections/pi/05d-diff-worker-lead.html?raw'
import piDiffGridB from '../components/landing/sections/pi/05e-diff-grid-b.html?raw'
import piWorker from '../components/landing/sections/pi/06-pi-worker.html?raw'
import piFaq from '../components/landing/sections/pi/08-faq.html?raw'
import piCloser from '../components/landing/sections/pi/09-closer.html?raw'

// Homepage sections reused verbatim — same file, same ids, same behavior.
import agents from '../components/landing/sections/07-agents.html?raw'
import helloWorld from '../components/landing/sections/06-hello-world.html?raw'
import workers from '../components/landing/sections/05-workers.html?raw'
import techSpecs from '../components/landing/sections/10-tech-specs.html?raw'
import footer from '../components/landing/sections/11-footer.html?raw'

// Behavior scripts these sections need. Skipped: 01 (homepage-only Slack
// chat sequencer) and 04/07 (the internal design tweaks panel) — neither
// has markup on this page. The rest guard every lookup on element presence,
// so including them is safe even where only some of their targets exist.
import pageBehaviors from '../components/landing/scripts/02-page-behaviors.html?raw'
import workersTicker from '../components/landing/scripts/03-workers-ticker-nested-in-nutshell.html?raw'
import heroViz from '../components/landing/scripts/05-hero-viz-engine.html?raw'
import agentSections from '../components/landing/scripts/06-agent-sections-a-harness-collapse-c-.html?raw'

const body = [
  piProblem,
  piReframe,
  agents,
  piCompare,
  piDiffLead,
  helloWorld,
  piDiffPayoff,
  piDiffGridA,
  piDiffWorkerLead,
  workers,
  piDiffGridB,
  piWorker,
  techSpecs,
  piFaq,
  piCloser,
  footer,
  pageBehaviors,
  workersTicker,
  heroViz,
  agentSections,
].join('')
---

<HtmlShell
  title="iii vs Pi — the system underneath your harness"
  description="Pi makes the harness yours. iii makes the whole stack yours: workers, triggers, and functions on one protocol, with the harness as one participant instead of the whole system."
  canonicalPath="/pi"
  keywords="iii, pi, pi agent, coding agent harness, worker, trigger, function, three primitives, agent runtime, cross-language workers, durable orchestration, worker registry, MCP alternative"
>
  <Fragment slot="head" set:html={piHeadExtras} />
  <Fragment set:html={sheetOpen} />
  <SiteNav pageTitle="vs pi" />
  <ScrollNav
    links={[
      { id: 'problem', label: 'problem' },
      { id: 'reframe', label: 'reframe' },
      { id: 'compare', label: 'compare' },
      { id: 'differentiators', label: 'extend' },
      { id: 'faq', label: 'faq' },
    ]}
  />
  <Fragment set:html={piHero} />
  <Fragment set:html={body} />
</HtmlShell>
