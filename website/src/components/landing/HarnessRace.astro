---
// HARNESS. The split-race animation: a traditional coding agent (left) against
// the same prompt run through iii (right). The animation is a React island over
// the vendored omelette timeline engine in ./animation/; client:only because the
// engine publishes its API on globalThis at import time. The console section
// right below (ConsoleLive) shows the same run from inside the harness.
import SplitRaceStyled from './animation/split-race-styled.jsx'
---

<section class="xp" id="harness" aria-label="Same prompt, two harnesses">
  <header class="xp-head">
    <h2 class="xp-title">
      <span class="accent">same work.</span>
      <span class="mute"
        ><b style="color:var(--ink); font-weight:500">two outcomes.</b><br />One
        agent researches a stack and resolves merge conflicts. The other finds
        what it needs and ships in the same timeframe.</span
      >
    </h2>
  </header>

  <div class="harness-race">
    <SplitRaceStyled client:only="react" />
  </div>
</section>

<style is:global>
  /* The race's height is a function of its own width, and `aspect-ratio` will
     not do it: paired with a max-height it narrows the box instead of just
     shortening it, which shrinks the whole race. Container query units give
     the width without that side effect. */
  #harness.xp {
    container-type: inline-size;
  }
  .harness-race {
    position: relative;
    margin: 0 36px;
    /* Height only: at its authored 16:10 the race stands taller than a laptop
       screen once the column is wide, so the two terminals never sit on
       screen together. Keep the full column width and give back height. The
       scene follows this box's proportions (see split-race-styled.jsx), so
       the windows get shorter instead of the race getting smaller.

       340px is the room the section header, the nav band and the gap between
       them actually measure, so the title and the race land on screen together
       from a laptop's height up; 500px is the floor, where the transcripts
       still hold enough lines to read as terminals. Between the two the race
       overflows a little rather than shrinking further. */
    block-size: min(
      calc((100cqw - 72px) * 0.625),
      max(500px, calc(100dvh - 340px))
    );
  }
  /* The engine's own transport bar is authoring chrome; the page just loops. */
  /* !important: the engine sets display:flex inline on both of these. */
  .harness-race [data-omelette-chrome] {
    display: none !important;
  }
  /* Stage root paints its editor backdrop; let the page show through instead. */
  .harness-race [data-om-starter='animations-v2'] {
    background: transparent !important;
  }
  /* The canvas ships an inline drop shadow that outlines it like a card. */
  .harness-race [data-om-exportable-video-with-duration-secs] {
    box-shadow: none !important;
  }
  /* The side-by-side race needs desktop width to read; hide it on phones. */
  @media (max-width: 720px) {
    #harness.xp {
      display: none;
    }
  }
</style>
